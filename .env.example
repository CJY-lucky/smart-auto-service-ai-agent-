# ===== 聊天大模型（本项目默认 DeepSeek）=====
# 可选：deepseek / qwen / zhipu / openai / openai-compatible / azure
MODEL_PROVIDER=deepseek
LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== 向量模型（Embedding）=====
# 注意：DeepSeek 目前不提供通用 Embedding 接口，需要单独配置。
#   local  —— 本地确定性向量，无需密钥、离线可跑（默认，适合开发与测试）
#   qwen   —— 阿里云百炼 text-embedding-v3
#   zhipu  —— 智谱 embedding-3
#   openai —— text-embedding-3-small
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# ===== 数据库 =====
DATABASE_URL=sqlite:///data/smart_auto_service.db

# ===== 运行参数 =====
DEBUG=True
LOG_LEVEL=INFO
DEFAULT_OWNER_ID=default_owner
ENABLE_SCHEDULER=True
WEATHER_CITY=Beijing

# ===== 外部工具（可选）=====
OPENWEATHER_API_KEY=

# ===== 可选：Azure OpenAI =====
# MODEL_PROVIDER=azure
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_VERSION=
# AZURE_OPENAI_DEPLOYMENT_EMBEDDING=
# AZURE_OPENAI_ENDPOINT_EMBEDDING=
# AZURE_OPENAI_EMBEDDING_VERSION=